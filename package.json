{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:local": "node scripts/server-local.mjs",
    "serve": "node scripts/server-local.mjs",
    "dev:s6lite": "node scripts/server-s6lite.mjs",
    "dev:s25ultra": "node scripts/server-s25ultra.mjs",
    "dev:both": "node scripts/server-both.mjs",
    "dev:mobile": "node scripts/mobile-server.mjs",
    "dev:full": "node scripts/server-full.mjs",
    "dev:https": "node scripts/mobile-server.mjs --https",
    "start": "node scripts/server-local.mjs",
    "build": "vite build",
    "preview": "vite preview --host=0.0.0.0",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); try{fs.unlinkSync('server.js')}catch(e){}\"",
    "lint": "tsc --noEmit",
    "dev:remote": "node scripts/remote-server.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.14",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@webgpu/types": "^0.1.72",
    "playwright": "^1.63.0",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
